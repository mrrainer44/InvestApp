[Unit]
Description=GPW Tracker - aplikacja WWW
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gpwtracker
WorkingDirectory=/opt/gpw-tracker
EnvironmentFile=/etc/gpw-tracker.env
ExecStart=/opt/gpw-tracker/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
