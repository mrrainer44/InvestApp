# Skopiuj do /etc/gpw-tracker.env (chmod 600) i zmień hasło.
GPWT_USER=gpw
GPWT_PASSWORD=zmien-to-haslo
# Adres, na którym słucha gunicorn - zostaw lokalny, jeśli przed nim stoi nginx/Caddy z HTTPS.
GPWT_BIND=127.0.0.1:8050
# Opcjonalnie: folder z analizami fundamentalnymi w OneDrive (rclone, remote tylko do odczytu)
#GPWT_AF_REMOTE=gpwaf:Dokumenty/Analizy fundamentalne
# Daty sesji i "dzisiaj" liczone są wg czasu polskiego, niezależnie od strefy serwera.
TZ=Europe/Warsaw
